<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Hidden by default, per this repository's settings workflow: RIMMSQOL and other
    MainButtons-customization mods can reveal it, but it is neither visible nor greyed out
    on a clean install. It opens the exact same Dialog_ModSettings, for the same loaded mod
    instance, as Options > Mod settings > Skill Icons - never a separate or reduced page.
  -->
  <MainButtonDef>
    <defName>SkillIcons_Settings</defName>
    <label>Skill Icons</label>
    <description>Open the Skill Icons mod settings.</description>
    <workerClass>SkillIcons.MainButtonWorker_Settings</workerClass>
    <buttonVisible>false</buttonVisible>
    <validWithoutMap>true</validWithoutMap>
    <canBeTutorDenied>false</canBeTutorDenied>
    <order>990</order>
  </MainButtonDef>

</Defs>
