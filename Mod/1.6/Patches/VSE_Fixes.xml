<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    VSE_Apathy declares no workBoxIconPath: in the Work tab, a skill's cell
    stays empty while it is apathetic, when every other passion shows
    something there. It is given its own grey outline, which already
    exists - the same texture as its list icon.

    This is the only place where this mod touches a Vanilla Skills Expanded
    def. In <success>Always</success>: if VSE adds this field one day, the
    patch goes inert instead of reddening the log. It is a plain operation
    rather than a sequence of one, for the same reason AlphaSkills_Fixes.xml
    no longer holds its five fixes in a chain.
  -->
  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>/Defs/VSE.Passions.PassionDef[defName="VSE_Apathy"]</xpath>
    <value>
      <workBoxIconPath>Passions/PassionApathy</workBoxIconPath>
    </value>
  </Operation>

</Patch>
