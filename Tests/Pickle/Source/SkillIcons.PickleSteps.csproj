<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Step definitions for the Pickle suite in ../Mod/Pickle/Features. Only Pickle loads this
    assembly: it lives in the companion test mod, never in the SkillIcons folder that goes to the
    Workshop. Mirrors ArchitectStudio/Tests/Pickle/Source and WorkStudio/Tests/Pickle/Source.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SkillIcons.PickleSteps</AssemblyName>
    <RootNamespace>SkillIcons.PickleSteps</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <OutputPath>..\Mod\Pickle\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time stubs only: the game, Harmony, VSE and the Pickle mod supply the real assemblies. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="RimWorks.Pickle.Ref" Version="4.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bound by name at run time: RimWorld loads SkillIcons before Pickle loads this assembly. -->
    <Reference Include="SkillIcons">
      <HintPath>..\..\..\Mod\1.6\Assemblies\SkillIcons.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- VSE.Passions.PassionDef: the granted-passion-def step reads isTriggered/learnRateFactor/hediffToAdd. -->
    <Reference Include="VSE">
      <HintPath>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\3400246558\1.6\Assemblies\VSE.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
