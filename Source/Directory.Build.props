<Project>

  <PropertyGroup>
    <!--
      Tooling project, not mod content: its intermediates go outside the published folder like
      everyone else's. The _tools folder itself stays in the repository; whether it ships to the
      Workshop is decided by the junction, which targets Mod/ alone.
    -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\.build\obj\SkillIcons-tools\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\.build\bin\SkillIcons-tools\</BaseOutputPath>
  </PropertyGroup>

</Project>
